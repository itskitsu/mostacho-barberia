        "operation": "executeQuery",
        "query": "SELECT c.id, c.telefono, c.servicio, c.barbero, c.fecha_hora_inicio, cl.nombre\nFROM citas c\nJOIN clientes cl ON cl.telefono = c.telefono\nWHERE c.estado = 'agendada'\n  AND c.recordatorio_24h_enviado = false\n  AND c.fecha_hora_inicio > (NOW() AT TIME ZONE 'America/Bogota')\n  AND c.fecha_hora_inicio <= (NOW() AT TIME ZONE 'America/Bogota') + INTERVAL '24 hours';",
        "options": {}
      },
